# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is git-ignored - never commit real secrets (see docs/v2/security-design.md#secrets-management).

# MySQL root password - shared by the mysql and backend services.
MYSQL_ROOT_PASSWORD=change-me

# JWT signing secret - must be a long random string in any non-local environment.
JWT_SECRET=change-me-to-a-long-random-string

# Optional - defaults match src/main/resources/application.properties if omitted.
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
